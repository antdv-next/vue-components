{
  "name": "@v-c/resize-observer",
  "type": "module",
  "version": "1.1.3",
  "license": "MIT",
  "homepage": "https://github.com/antdv-next/vue-components/tree/next/packages/resize-observer",
  "repository": {
    "type": "git",
    "url": "https://github.com/antdv-next/vue-components.git"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./dist/*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "default": "./dist/*.js"
    },
    "./dist/utils/*": {
      "types": "./dist/utils/*.d.ts",
      "import": "./dist/utils/*.js",
      "default": "./dist/utils/*.js"
    },
    "./package.json": "./package.json"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "package.json"
  ],
  "scripts": {
    "build": "vite build",
    "prepublish": "pnpm build",
    "bump": "bumpp",
    "bump:patch": "bumpp --release patch"
  },
  "peerDependencies": {
    "vue": "^3.0.0"
  },
  "dependencies": {
    "@v-c/util": "workspace:^",
    "resize-observer-polyfill": "^1.5.1"
  }
}
